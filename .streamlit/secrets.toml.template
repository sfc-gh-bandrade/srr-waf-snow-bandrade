# Snowflake Connection Configuration
# Copy this file to secrets.toml and fill in your credentials
# NEVER commit secrets.toml to version control!

[snowflake]
account = "your_account_identifier"  # e.g., "xy12345.us-east-1" or "orgname-accountname"
user = "your_username"
password = "your_password"
role = "ACCOUNTADMIN"  # or another role with ACCOUNT_USAGE access
warehouse = "your_warehouse"  # e.g., "COMPUTE_WH"

# Optional: Additional parameters
# database = "your_database"
# schema = "your_schema"
# authenticator = "externalbrowser"  # For SSO/MFA
